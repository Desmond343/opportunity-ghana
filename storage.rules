rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdminOrEditor() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.editor == true
      );
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)') &&
             request.resource.size <= 5 * 1024 * 1024;
    }
    
    // User personal storage (CVs, profile photos)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Application documents submitted by user
    match /applications/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Opportunity photos: Publicly viewable, authenticated user upload for submissions, admin/editor upload and deletion
    match /opportunities/{opportunityId}/{filename} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage();
      allow delete: if isAdminOrEditor();
    }

    // Resource photos: Publicly viewable, authenticated user upload for submissions, admin/editor upload and deletion
    match /resources/{resourceId}/{filename} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage();
      allow delete: if isAdminOrEditor();
    }

    // Public assets (organization logos, verified attachments)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminOrEditor() && isValidImage();
      allow delete: if isAdminOrEditor();
    }
  }
}
